(version 1)
# OpenDAP fab rules: PCBWay advanced multilayer, through vias only, 18 um base copper
#
# Process: PCBWay advanced multilayer (4 or 6 layers), through vias only.
# Stackup assumed: 18 um (1/2 oz) base copper on every layer, FR-4. For 35 um
# (1 oz) base copper on any layer use pcbway-multilayer-35um.kicad_dru. See
# README.md for the stackup, what DRC cannot check, and the values still
# UNVERIFIED.
#
# Every value is a PCBWay published figure, copied in
# design-rules/pcbway-capabilities.md (pages fetched 2026-10-22) and
# cited by its source key:
#   [P1]  https://www.pcbway.com/capabilities.html
#   [P2]  https://www.pcbway.com/advanced-pcb-capabilities.html
# Where PCBWay gives a normal value and a tighter limit, the rule uses the
# normal value. A product that needs the limit overrides the rule in its own
# product rules, in a named area or net class.
#
# Mil figures are written in mil (1 mil = 0.0254 mm), exactly as published.
# KiCad applies the LAST matching rule for a constraint: general rules come
# first, specific ones after them.
#
# Use: copy next to the KiCad project as <project>.kicad_dru.


# --- Copper clearance and track width (18 um base copper) ---

# Outer track/space before compensation, 18 um: >= 4/5 mil normal (4/4 mil
# medium). [P1]
(rule "PCBWay multilayer: Copper clearance (outer)"
	(layer outer)
	(constraint clearance (min 5mil))
)

# Inner track/space, 18 um: >= 4/4 mil normal (4/3.5 mil medium). [P1]
(rule "PCBWay multilayer: Copper clearance (inner)"
	(layer inner)
	(constraint clearance (min 4mil))
)

# Outer track width, 18 um: 4 mil. [P1]
(rule "PCBWay multilayer: Track width (outer)"
	(layer outer)
	(constraint track_width (min 4mil))
)

# Inner track width, 18 um: 4 mil. [P1]
(rule "PCBWay multilayer: Track width (inner)"
	(layer inner)
	(constraint track_width (min 4mil))
)


# --- Vias ---

# Through vias only: this set targets the through-via build (process scope of this set).
# Blind, buried and laser microvias belong to pcbway-hdi.
(rule "PCBWay multilayer: Through vias only"
	(condition "A.Type == 'Via'")
	(constraint disallow micro_via blind_via buried_via)
)


# --- Drilling ---

# Mechanical drill 0.20-6.5 mm (advanced, normal). Every drilled hole. [P1]
(rule "PCBWay multilayer: Mechanical drill"
	(condition "A.Type == 'Pad' || A.Type == 'Via'")
	(constraint hole_size (min 0.2mm) (max 6.5mm))
)

# Via annular ring, outer, 18-35 um copper: >= 5 mil normal (4 mil medium,
# 3 mil advanced minimum). [P1, P2]
(rule "PCBWay multilayer: Via annular ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 5mil))
)

# Hole to hole, vias <= 0.45 mm: >= 11 mil. [P1]
(rule "PCBWay multilayer: Via hole to hole"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 11mil))
)


# --- Hole to copper ---

# Hole to conductor, outer layers: 6 mil (advanced). [P2]
(rule "PCBWay multilayer: Hole to copper (outer)"
	(layer outer)
	(constraint hole_clearance (min 6mil))
)

# Hole to inner conductor: 8 mil normal for 6 layers (7 mil for 4 layers;
# the 6-layer figure covers both). [P1]
(rule "PCBWay multilayer: Hole to copper (inner)"
	(layer inner)
	(constraint hole_clearance (min 8mil))
)


# --- Board edge ---

# Line to board edge (milled): 0.20 mm. [P1]
(rule "PCBWay multilayer: Copper to board edge"
	(constraint edge_clearance (min 0.2mm))
)


# --- Legend ---

# Silkscreen line >= 0.15 mm (character stroke). [P1]
(rule "PCBWay multilayer: Silkscreen line width"
	(layer "?.SilkS")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
)

# Silkscreen height >= 0.8 mm. [P1]
(rule "PCBWay multilayer: Silkscreen text height"
	(layer "?.SilkS")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_height (min 0.8mm))
)
